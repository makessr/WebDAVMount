    "predev": "node build/guard-picomatch.mjs",
    "pretest": "node build/guard-picomatch.mjs"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.4",
    "vue-tsc": "^3.3.12"
  }
}
